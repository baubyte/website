APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR (PR10). Leave disabled for local DDEV dev -- DDEV never
# starts the `ssr` docker-compose service, so the Node SSR server simply
# isn't reachable and every request would otherwise wait out an HTTP
# timeout before falling back to client-side rendering. In production,
# `INERTIA_SSR_URL` points at the `ssr` service by its Docker Compose
# service name (containers reach each other by name over the shared
# bridge network, not via localhost/127.0.0.1).
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://ssr:13714

# Chat proxy (PR11, D8). `ChatController` is the only thing that ever talks
# to n8n -- these must never be exposed to the browser. Operational
# dependency the owner sets up before go-live; while unset, POST /api/chat
# fails closed with a 503 instead of calling an unauthenticated endpoint.
# N8N_CHAT_WEBHOOK_URL=
# N8N_CHAT_WEBHOOK_SECRET=
WEASYPRINT_BINARY=/usr/bin/weasyprint

# DEPLOYMENT
DEPLOY_HOST=default-host
DEPLOY_USER=default-user
DEPLOY_PATH=/default/path
DEPLOY_REPO=git@github.com:user/repo.git
